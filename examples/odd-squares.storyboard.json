  "scenes": [
    {
      "id": "01",
      "title": "Hook",
      "narration": "Add the first four odd numbers. What do you get?",
      "template": "custom",
      "elements": [
        {
          "kind": "equation",
          "tex": "1 + 3 + 5 + 7 = \\,?",
          "position": "center"
        }
      ],
      "beats": [
        {
          "t": 0.0,
          "action": "pop_in",
          "target": "sum"
        },
        {
          "on": "odd",
          "action": "highlight",
          "target": "sum"
        }
      ],
      "est_duration_s": 4.5,
      "assets": []
    },
    {
      "id": "02",
      "title": "A pattern",
      "narration": "One, three, five, seven makes sixteen. That is four times four. Three odd numbers make nine. Two make four.",
      "template": "EquationReveal",
      "elements": [
        {
          "kind": "equation",
          "tex": "1+3+5+7 = 16 = 4^2",
          "position": "center"
        },
        {
          "kind": "equation",
          "tex": "1+3+5 = 9 = 3^2",
          "position": "bottom"
        }
      ],
      "beats": [
        {
          "on": "sixteen",
          "action": "write",
          "target": "equation 1"
        },
        {
          "on": "nine",
          "action": "write",
          "target": "equation 2"
        }
      ],
      "est_duration_s": 9.6,
      "assets": []
    },
    {
      "id": "03",
      "title": "Layers of a square",
      "narration": "Here is why. Each odd number is an L shaped layer. One dot, then three more wrap around it, then five, then seven. Every layer keeps the shape a square.",
      "template": "custom",
      "elements": [
        {
          "kind": "shape",
          "shape": "grid",
          "label": "4 by 4 dots",
          "position": "center"
        }
      ],
      "beats": [
        {
          "on": "three",
          "action": "pop_in",
          "target": "layer 2"
        },
        {
          "on": "five",
          "action": "pop_in",
          "target": "layer 3"
        },
        {
          "on": "seven",
          "action": "pop_in",
          "target": "layer 4"
        }
      ],
      "est_duration_s": 12.4,
      "assets": []
    },
    {
      "id": "04",
      "title": "In general",
      "narration": "So the first n odd numbers always add up to n squared.",
      "template": "EquationReveal",
      "elements": [
        {
          "kind": "equation",
          "tex": "\\sum_{k=1}^{n}(2k-1) = n^2",
          "position": "center"
        }
      ],
      "beats": [
        {
          "on": "n",
          "action": "write",
          "target": "equation"
        },
        {
          "on": "squared",
          "action": "highlight",
          "target": "n^2"
        }
      ],
      "est_duration_s": 5.1,
      "assets": []
    },
    {
      "id": "05",
      "title": "Check it",
      "narration": "A line of code agrees. The sum of the odd numbers up to two n minus one equals n times n.",
      "template": "CodeBlock",
      "elements": [
        {
          "kind": "code",
          "lang": "python",
          "value": "n = 4\nodds = range(1, 2 * n, 2)\nprint(sum(odds) == n * n)",
          "position": "center"
        }
      ],
      "beats": [
        {
          "t": 0.0,
          "action": "write",
          "target": "code"
        },
        {
          "on": "equals",
          "action": "highlight",
          "target": "last line"
        }
      ],
      "est_duration_s": 7.9,
      "assets": []
    },
